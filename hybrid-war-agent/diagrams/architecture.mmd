flowchart TD
    subgraph AWS[VPC - AWS Cloud]
        direction TB
        IGW[Internet Gateway]
        ALB[Ingress / ALB]
        EKS[EKS Cluster]
        ETLJob[ETL Job]
        NLPJob[NLP Job]
        ScoreJob[Scoring Job]
        Kinesis[Kinesis Stream]
        S3Bucket[S3 Buckets]
